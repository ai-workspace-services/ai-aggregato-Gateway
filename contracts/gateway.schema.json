{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace-services.github.io/gateway/contracts/gateway.schema.json",
  "title": "AI Gateway public contract",
  "type": "object",
  "required": ["schema_version", "gateway", "upstreams", "tenants", "routes"],
  "properties": {
    "schema_version": {"const": "v1"},
    "gateway": {
      "type": "object",
      "required": ["adapter", "environment"],
      "properties": {
        "adapter": {"enum": ["caddy", "kong", "nginx", "apisix"]},
        "mode": {"type": "string"},
        "entry_mode": {"enum": ["gateway", "direct-new-api"]},
        "environment": {"type": "string", "minLength": 1},
        "domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "runtime_config_backend": {"type": "string"},
        "etcd": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "upstreams": {"type": "array", "minItems": 1},
    "tenants": {"type": "array", "minItems": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "hosts", "paths", "upstream", "tenant_ref", "auth"],
        "properties": {
          "auth": {
            "type": "object",
            "required": ["mode"],
            "properties": {"mode": {"enum": ["key-auth", "jwt", "new-api-token"]}},
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
